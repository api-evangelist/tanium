          "name": "List Threat Alerts",
          "request": {
            "name": "List Threat Alerts",
            "description": {
              "content": "Retrieves a paginated list of threat alerts. Alerts can be filtered by computer name, IP address, severity, priority, type, state, and associated intel document or scan configuration.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "plugin",
                "products",
                "threat-response",
                "api",
                "v1",
                "alerts"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "limit",
                  "value": "<integer>",
                  "description": "Maximum number of alerts to return"
                },
                {
                  "disabled": false,
                  "key": "offset",
                  "value": "<integer>",
                  "description": "Number of alerts to skip for pagination"
                },
                {
                  "disabled": false,
                  "key": "computer_ip_address",
                  "value": "<string>",
                  "description": "Filter by computer IP address"
